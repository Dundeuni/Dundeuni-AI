# Repository-local defaults
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Configuration files
[*.{yml,yaml,json,toml}]
indent_size = 2

# Preserve Markdown hard line breaks
[*.md]
trim_trailing_whitespace = false

# Preserve upstream source bytes; do not apply project defaults here
[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
