# Configuration checklist only. The API does NOT automatically read .env files.
# Set these values as environment variables before starting the API.
# No real token/API key is included.
AI_SERVICE_TOKEN=
# Set to the absolute path of the separately supplied trained model folder.
AI_TEXT_MODEL_DIR=
# auto: CPU without CUDA; CUDA requires native BF16 support or startup fails.
# cpu: explicitly use FP32 CPU loading; cuda_bf16: require native CUDA BF16.
AI_TEXT_DEVICE=auto
AI_OCR_TIMEOUT_SECONDS=90
AI_URL_REPUTATION_ENABLED=0
AI_WEBRISK_API_KEY=
