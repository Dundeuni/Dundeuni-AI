{
  "openapi": "3.1.0",
  "info": {
    "title": "A.X 문자 사기 위험 분석 API",
    "description": "문자 사기 분석 전용. CuRe/TruFor 이미지 생성·변조 API와 별도입니다.",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "기동 및 분류기 준비 상태",
        "operationId": "health_healthz_get",
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional UUID v4. The server generates one when omitted or empty. An invalid nonempty value returns 422 INVALID_REQUEST_ID with a fresh requestId and no X-Request-ID response header.",
              "format": "uuid4",
              "title": "X-Request-Id"
            },
            "description": "Optional UUID v4. The server generates one when omitted or empty. An invalid nonempty value returns 422 INVALID_REQUEST_ID with a fresh requestId and no X-Request-ID response header."
          }
        ],
        "responses": {
          "200": {
            "description": "Classifier ready; reports the selected device.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_REQUEST_ID: invalid UUID v4 header.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "ANALYSIS_FAILED: unexpected internal error.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/text-analyses": {
      "post": {
        "summary": "문자 본문 분석 (JSON)",
        "operationId": "analyze_text_internal_v1_text_analyses_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional UUID v4. The server generates one when omitted or empty. An invalid nonempty value returns 422 INVALID_REQUEST_ID with a fresh requestId and no X-Request-ID response header.",
              "format": "uuid4",
              "title": "X-Request-Id"
            },
            "description": "Optional UUID v4. The server generates one when omitted or empty. An invalid nonempty value returns 422 INVALID_REQUEST_ID with a fresh requestId and no X-Request-ID response header."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed analysis. A defer decision also returns HTTP 200 with status COMPLETED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextRiskResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: missing or invalid Bearer service credentials.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              },
              "WWW-Authenticate": {
                "description": "Always returned for 401 UNAUTHORIZED.",
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "REQUEST_TOO_LARGE: request body exceeds 11 MiB.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_REQUEST for invalid fields or formats; INVALID_REQUEST_ID for a non-UUID-v4 X-Request-ID header. INVALID_TEXT for invalid text.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "ANALYZER_BUSY when another analysis is running; ANALYSIS_FAILED for an unexpected internal error.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              },
              "Retry-After": {
                "description": "Returned with value 2 only for ANALYZER_BUSY; absent for OCR_UNAVAILABLE and unexpected ANALYSIS_FAILED errors.",
                "schema": {
                  "type": "string",
                  "const": "2"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/text-analyses/image": {
      "post": {
        "summary": "이미지 OCR 후 문자 사기 위험 분석 (multipart)",
        "operationId": "analyze_image_internal_v1_text_analyses_image_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional UUID v4. The server generates one when omitted or empty. An invalid nonempty value returns 422 INVALID_REQUEST_ID with a fresh requestId and no X-Request-ID response header.",
              "format": "uuid4",
              "title": "X-Request-Id"
            },
            "description": "Optional UUID v4. The server generates one when omitted or empty. An invalid nonempty value returns 422 INVALID_REQUEST_ID with a fresh requestId and no X-Request-ID response header."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_image_internal_v1_text_analyses_image_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed analysis. A defer decision also returns HTTP 200 with status COMPLETED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextRiskResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: missing or invalid Bearer service credentials.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              },
              "WWW-Authenticate": {
                "description": "Always returned for 401 UNAUTHORIZED.",
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "REQUEST_TOO_LARGE for a request body over 11 MiB; IMAGE_TOO_LARGE for an image file over 10 MiB.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_REQUEST for invalid fields or formats; INVALID_REQUEST_ID for a non-UUID-v4 X-Request-ID header. EMPTY_IMAGE, IMAGE_DIMENSIONS, INVALID_IMAGE, or OCR_TEXT_TOO_LONG for invalid image/OCR input.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "OCR_UNAVAILABLE when the OCR worker is not prepared; ANALYZER_BUSY when another analysis is running; ANALYSIS_FAILED for an unexpected internal error.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              },
              "Retry-After": {
                "description": "Returned with value 2 only for ANALYZER_BUSY; absent for OCR_UNAVAILABLE and unexpected ANALYSIS_FAILED errors.",
                "schema": {
                  "type": "string",
                  "const": "2"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_IMAGE, IMAGE_TYPE_MISMATCH, or ANIMATED_IMAGE for unsupported MIME types, mismatched formats, or multiple frames.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "OCR_FAILED: OCR worker or its result failed.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "OCR_TIMEOUT: OCR worker exceeded its time limit.",
            "headers": {
              "X-Request-ID": {
                "description": "Echoes the validated UUID v4 or the generated UUID v4 after request context completes. Absent for INVALID_REQUEST_ID and not guaranteed for unexpected internal errors.",
                "schema": {
                  "type": "string",
                  "format": "uuid4"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
